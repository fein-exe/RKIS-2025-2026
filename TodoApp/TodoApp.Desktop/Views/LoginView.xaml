<UserControl x:Class="TodoApp.Desktop.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid MaxWidth="430" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel>
            <TextBlock Text="&#x0412;&#x0445;&#x043E;&#x0434; &#x0432; &#x043F;&#x0440;&#x043E;&#x0444;&#x0438;&#x043B;&#x044C;" FontSize="30" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock Text="&#x0412;&#x0432;&#x0435;&#x0434;&#x0438;&#x0442;&#x0435; &#x0434;&#x0430;&#x043D;&#x043D;&#x044B;&#x0435; &#x043F;&#x043E;&#x043B;&#x044C;&#x0437;&#x043E;&#x0432;&#x0430;&#x0442;&#x0435;&#x043B;&#x044F;" Foreground="#64748B" Margin="0,0,0,24" />

            <TextBlock Text="&#x041B;&#x043E;&#x0433;&#x0438;&#x043D;" FontWeight="SemiBold" />
            <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="&#x041F;&#x0430;&#x0440;&#x043E;&#x043B;&#x044C;" FontWeight="SemiBold" />
            <PasswordBox PasswordChanged="PasswordBox_PasswordChanged" />

            <TextBlock Text="{Binding ErrorMessage}" Foreground="#B42318" Margin="0,0,0,14" />

            <StackPanel Orientation="Horizontal">
                <Button Content="&#x0412;&#x043E;&#x0439;&#x0442;&#x0438;" Command="{Binding LoginCommand}" />
                <Button Content="&#x0420;&#x0435;&#x0433;&#x0438;&#x0441;&#x0442;&#x0440;&#x0430;&#x0446;&#x0438;&#x044F;"
                        Command="{Binding ShowRegisterCommand}"
                        Style="{DynamicResource SecondaryButton}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
