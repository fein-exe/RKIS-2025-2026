<UserControl x:Class="TodoApp.Desktop.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid MaxWidth="560" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel>
            <TextBlock Text="&#x0420;&#x0435;&#x0433;&#x0438;&#x0441;&#x0442;&#x0440;&#x0430;&#x0446;&#x0438;&#x044F;" FontSize="30" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock Text="&#x0421;&#x043E;&#x0437;&#x0434;&#x0430;&#x043D;&#x0438;&#x0435; &#x043D;&#x043E;&#x0432;&#x043E;&#x0433;&#x043E; &#x043F;&#x0440;&#x043E;&#x0444;&#x0438;&#x043B;&#x044F;" Foreground="#64748B" Margin="0,0,0,24" />

            <TextBlock Text="&#x041B;&#x043E;&#x0433;&#x0438;&#x043D;" FontWeight="SemiBold" />
            <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="&#x041F;&#x0430;&#x0440;&#x043E;&#x043B;&#x044C;" FontWeight="SemiBold" />
            <PasswordBox PasswordChanged="PasswordBox_PasswordChanged" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="&#x0418;&#x043C;&#x044F;" FontWeight="SemiBold" />
                    <TextBox Text="{Binding FirstName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="&#x0424;&#x0430;&#x043C;&#x0438;&#x043B;&#x0438;&#x044F;" FontWeight="SemiBold" />
                    <TextBox Text="{Binding LastName, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>

            <TextBlock Text="&#x0413;&#x043E;&#x0434; &#x0440;&#x043E;&#x0436;&#x0434;&#x0435;&#x043D;&#x0438;&#x044F;" FontWeight="SemiBold" />
            <TextBox Text="{Binding BirthYear, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="{Binding ErrorMessage}" Foreground="#B42318" Margin="0,0,0,14" />

            <StackPanel Orientation="Horizontal">
                <Button Content="&#x0421;&#x043E;&#x0437;&#x0434;&#x0430;&#x0442;&#x044C;" Command="{Binding RegisterCommand}" />
                <Button Content="&#x041D;&#x0430;&#x0437;&#x0430;&#x0434;"
                        Command="{Binding ShowLoginCommand}"
                        Style="{DynamicResource SecondaryButton}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
