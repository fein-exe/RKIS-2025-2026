<UserControl x:Class="TodoApp.Desktop.Views.AddTaskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid MaxWidth="680" VerticalAlignment="Center" HorizontalAlignment="Center">
        <StackPanel>
            <TextBlock Text="&#x041D;&#x043E;&#x0432;&#x0430;&#x044F; &#x0437;&#x0430;&#x0434;&#x0430;&#x0447;&#x0430;" FontSize="30" FontWeight="SemiBold" Margin="0,0,0,6" />
            <TextBlock Text="&#x0417;&#x0430;&#x043F;&#x043E;&#x043B;&#x043D;&#x0438;&#x0442;&#x0435; &#x0442;&#x0435;&#x043A;&#x0441;&#x0442; &#x0438; &#x043D;&#x0430;&#x0447;&#x0430;&#x043B;&#x044C;&#x043D;&#x044B;&#x0439; &#x0441;&#x0442;&#x0430;&#x0442;&#x0443;&#x0441;" Foreground="#64748B" Margin="0,0,0,24" />

            <TextBlock Text="&#x0422;&#x0435;&#x043A;&#x0441;&#x0442; &#x0437;&#x0430;&#x0434;&#x0430;&#x0447;&#x0438;" FontWeight="SemiBold" />
            <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                     MinHeight="130"
                     Height="130"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalContentAlignment="Top" />

            <TextBlock Text="&#x0421;&#x0442;&#x0430;&#x0442;&#x0443;&#x0441;" FontWeight="SemiBold" />
            <ComboBox ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding Status}" />

            <TextBlock Text="{Binding ErrorMessage}" Foreground="#B42318" Margin="0,0,0,14" />

            <StackPanel Orientation="Horizontal">
                <Button Content="&#x0414;&#x043E;&#x0431;&#x0430;&#x0432;&#x0438;&#x0442;&#x044C;" Command="{Binding SaveCommand}" />
                <Button Content="&#x041E;&#x0442;&#x043C;&#x0435;&#x043D;&#x0430;"
                        Command="{Binding CancelCommand}"
                        Style="{DynamicResource SecondaryButton}" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
