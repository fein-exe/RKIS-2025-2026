<UserControl x:Class="TodoApp.Desktop.Views.TodoListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="0,0,0,18">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="&#x0421;&#x043F;&#x0438;&#x0441;&#x043E;&#x043A; &#x0437;&#x0430;&#x0434;&#x0430;&#x0447;" FontSize="30" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ProfileName}" Foreground="#64748B" Margin="0,4,0,0" />
                </StackPanel>
                <Button Content="&#x0412;&#x044B;&#x0439;&#x0442;&#x0438;"
                        Command="{Binding LogoutCommand}"
                        DockPanel.Dock="Right"
                        HorizontalAlignment="Right"
                        Style="{DynamicResource SecondaryButton}" />
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="&#x041F;&#x043E;&#x0438;&#x0441;&#x043A;" FontWeight="SemiBold" />
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="&#x0424;&#x0438;&#x043B;&#x044C;&#x0442;&#x0440;" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding FilterOptions}"
                              SelectedItem="{Binding SelectedFilter}"
                              DisplayMemberPath="Title" />
                </StackPanel>

                <StackPanel Grid.Column="4" VerticalAlignment="Bottom" Orientation="Horizontal" Margin="0,0,0,14">
                    <Button Content="&#x041E;&#x0431;&#x043D;&#x043E;&#x0432;&#x0438;&#x0442;&#x044C;"
                            Command="{Binding RefreshCommand}"
                            Style="{DynamicResource SecondaryButton}" />
                    <Button Content="&#x0414;&#x043E;&#x0431;&#x0430;&#x0432;&#x0438;&#x0442;&#x044C;" Command="{Binding ShowAddTaskCommand}" />
                </StackPanel>
            </Grid>
        </Grid>

        <DataGrid Grid.Row="1"
                  ItemsSource="{Binding Todos}"
                  SelectedItem="{Binding SelectedTodo}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  IsReadOnly="True"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowHeaderWidth="0">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="64" />
                <DataGridTextColumn Header="&#x0422;&#x0435;&#x043A;&#x0441;&#x0442;" Binding="{Binding Text}" Width="*" />
                <DataGridTextColumn Header="&#x0421;&#x0442;&#x0430;&#x0442;&#x0443;&#x0441;" Binding="{Binding Status}" Width="150" />
                <DataGridTextColumn Header="&#x0414;&#x0430;&#x0442;&#x0430; &#x0438;&#x0437;&#x043C;&#x0435;&#x043D;&#x0435;&#x043D;&#x0438;&#x044F;"
                                    Binding="{Binding LastUpdate, StringFormat={}{0:dd.MM.yyyy HH:mm}}"
                                    Width="180" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2"
                Background="#F8FAFC"
                BorderBrush="#D7DEE8"
                BorderThickness="1"
                CornerRadius="6"
                Padding="14"
                Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="&#x0421;&#x0442;&#x0430;&#x0442;&#x0443;&#x0441; &#x0432;&#x044B;&#x0431;&#x0440;&#x0430;&#x043D;&#x043D;&#x043E;&#x0439; &#x0437;&#x0430;&#x0434;&#x0430;&#x0447;&#x0438;" FontWeight="SemiBold" />
                    <ComboBox ItemsSource="{Binding StatusOptions}"
                              SelectedItem="{Binding SelectedStatus}"
                              Width="180"
                              Margin="0,5,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="&#x0420;&#x0435;&#x0434;&#x0430;&#x043A;&#x0442;&#x0438;&#x0440;&#x043E;&#x0432;&#x0430;&#x0442;&#x044C;"
                            Command="{Binding EditTaskCommand}"
                            Style="{DynamicResource SecondaryButton}" />
                    <Button Content="&#x0423;&#x0434;&#x0430;&#x043B;&#x0438;&#x0442;&#x044C;"
                            Command="{Binding DeleteTaskCommand}"
                            Background="#B42318"
                            BorderBrush="#B42318" />
                </StackPanel>

                <TextBlock Grid.Column="4"
                           Text="{Binding ErrorMessage}"
                           Foreground="#B42318"
                           VerticalAlignment="Bottom"
                           Margin="8,0,0,8" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
